PROGRAM main
  VAR
    STOP : BOOL AT %IX0.0;
    MODE : BOOL AT %IX0.1;
    PB_M1 : BOOL AT %IX0.2;
    FL1 : BOOL AT %IX0.5;
    TH1 : BOOL AT %IX1.0;
    LT1 : INT AT %IW0;
    KM1 : BOOL AT %QX0.0;
    MODE_AUTO : BOOL;
    SEL1 : BOOL := TRUE;
    SCHED1 : BOOL;
    ENABLE1 : BOOL;
    LVL_OK1 : BOOL;
    SP1 : INT := 5000;
    T_ON1 : TIME := T#5s;
    T_OFF1 : TIME := T#3s;
    TON_ON1 : TON;
    TON_OFF1 : TON;
  END_VAR

MODE_AUTO := MODE;

LVL_OK1 := SEL1 AND (LT1 > SP1);
ENABLE1 := STOP AND TH1 AND FL1 AND LVL_OK1;

TON_OFF1(IN := MODE_AUTO AND SEL1 AND NOT SCHED1, PT := T_OFF1);
IF TON_OFF1.Q THEN SCHED1 := TRUE; END_IF;
TON_ON1(IN := SCHED1, PT := T_ON1);
IF TON_ON1.Q THEN SCHED1 := FALSE; END_IF;

KM1 := ENABLE1 AND ( (MODE_AUTO AND SCHED1) OR (NOT MODE_AUTO AND (PB_M1 OR KM1)) );

END_PROGRAM